# Workspace-level documentation only. Runtime values live with each app.
# Never commit a real .env file.

# Frontend: safe public Supabase values only (when Auth is introduced).
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Backend: server-only values. Never expose these through Vite.
API_PORT=3000
# Render defines PORT automatically. API_PORT remains the local fallback.
# PORT=10000
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
DATABASE_URL=postgresql://user:password@host:5432/database
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=5000
GEMINI_API_KEY=server-only-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
AI_REQUESTS_PER_MINUTE=6
AI_CACHE_TTL_MS=300000
